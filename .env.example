# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Matching thresholds
MATCH_THRESHOLD=95
REVIEW_THRESHOLD=85

# Upload
MAX_UPLOAD_MB=15

# Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Optional: Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# Authentication
# Reuse o JWT_SECRET que já está configurado na Vercel. Não gere outro apenas para o login.
JWT_SECRET=""

# Seed inicial do único usuário (uso local/temporário; não precisa permanecer na Vercel)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
